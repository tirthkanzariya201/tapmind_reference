{
  "$schema": "https://jamdesk.com/docs.json",
  "projectId": "a7pYkYzx1U0EkFGx7BoW",
  "name": "TapMind Resources",
  "description": "Glossary and change logs for TapMind SDK Integration",
  "theme": "jam",
  "tabsPosition": "top",
  "colors": {
    "primary": "#FE7B49",
    "light": "#FE7B49",
    "dark": "#FE7B49"
  },
  "favicon": "/images/favicon.png",
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png"
  },
  "interaction": {
    "drilldown": false
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "seo": {
    "metatags": {
      "robots": "noindex, nofollow"
    },
    "ai": {
      "llmsTxt": false
    }
  },
  "auth": {
    "password": {
      "enabled": false
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://platform.tapmind.io/"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Resources",
        "icon": "book",
        "pages": [
          {
            "page": "glossary",
            "title": "Glossary"
          },
          {
            "group": "Changelog",
            "pages": [
              {
                "page": "changelog",
                "title": "SDK Changelog"
              },
              {
                "page": "release-notes",
                "title": "Backend Release Notes"
              }
            ]
          },
          {
            "page": "package-versions",
            "title": "Package Versions"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/glossary",
      "permanent": false
    },
    {
      "source": "/sdk-changelog/native-android-admob",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-android-gam",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-android-max",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-android-levelplay",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-ios-admob",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-ios-gam",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-ios-max",
      "destination": "/changelog",
      "permanent": true
    },
    {
      "source": "/sdk-changelog/native-ios-levelplay",
      "destination": "/changelog",
      "permanent": true
    }
  ]
}

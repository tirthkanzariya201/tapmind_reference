{
  "$schema": "https://jamdesk.com/docs.json",
  "projectId": "a7pYkYzx1U0EkFGx7BoW",
  "name": "TapMind Resources",
  "description": "Glossary and change logs for TapMind SDK Integration",
  "theme": "jam",
  "tabsPosition": "top",
  "colors": {
    "primary": "#FE7B49",
    "light": "#FE7B49",
    "dark": "#FE7B49"
  },
  "favicon": "/images/favicon.png",
  "logo": {
    "light": "/images/logo-light.png",
    "dark": "/images/logo-dark.png"
  },
  "interaction": {
    "drilldown": false
  },
  "appearance": {
    "default": "light",
    "strict": true
  },
  "auth": {
    "password": {
      "enabled": true,
      "hint": "Password-protected docs"
    }
  },
  "navbar": {
    "primary": {
      "type": "button",
      "label": "Get Started",
      "href": "https://platform.tapmind.io/"
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Resources",
        "icon": "book",
        "pages": [
          {
            "page": "glossary",
            "title": "Glossary"
          },
          {
            "group": "Changelog",
            "pages": [
              {
                "group": "SDK Changelog",
                "pages": [
                  {
                    "page": "sdk-changelog/native-android-admob",
                    "title": "Native Android AdMob"
                  },
                  {
                    "page": "sdk-changelog/native-android-gam",
                    "title": "Native Android GAM"
                  },
                  {
                    "page": "sdk-changelog/native-android-max",
                    "title": "Native Android AppLovin MAX"
                  },
                  {
                    "page": "sdk-changelog/native-android-levelplay",
                    "title": "Native Android LevelPlay"
                  },
                  {
                    "page": "sdk-changelog/native-ios-admob",
                    "title": "Native iOS AdMob"
                  },
                  {
                    "page": "sdk-changelog/native-ios-gam",
                    "title": "Native iOS GAM"
                  },
                  {
                    "page": "sdk-changelog/native-ios-max",
                    "title": "Native iOS AppLovin MAX"
                  },
                  {
                    "page": "sdk-changelog/native-ios-levelplay",
                    "title": "Native iOS LevelPlay"
                  }
                ]
              },
              {
                "page": "release-notes",
                "title": "Backend Release Notes"
              }
            ]
          },
          {
            "page": "package-versions",
            "title": "Package Versions"
          }
        ]
      }
    ]
  },
  "redirects": [
    {
      "source": "/",
      "destination": "/glossary",
      "permanent": false
    },
    {
      "source": "/changelog",
      "destination": "/sdk-changelog/native-android-admob",
      "permanent": false
    }
  ]
}
